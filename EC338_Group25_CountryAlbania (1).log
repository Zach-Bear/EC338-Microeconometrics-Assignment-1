. ** 3.2 Class gender composition (2014, 2018, 2022) **
. * If classes were formed at random: (a) family characteristics should not predict the
. * share of girls; (b) classes should differ in their share of girls by about as much as
. * random draws would (we simulate this below).
. eststo clear

. tempfile base pos gl

. foreach w in 2014 2018 2022 {
  2.     di _n "---- Class composition, wave `w' ----"
  3.     foreach x in fas_z momwork dadwork {
  4.         eststo K`w'_`x': quietly reg `x' share_girls_cls girl i.age_grp c.n_class if s_cls & wave == `w', vce(cluster clas
> sid)
  5.     }
  6.     di "Joint test: do affluence and parents' work predict the share of girls?"
  7.     quietly reg share_girls_cls girl fas_z momwork dadwork i.age_grp c.n_class if s_cls & wave == `w', vce(cluster classid
> )
  8.     testparm fas_z momwork dadwork
  9.     di "Does a student's own sex predict the share of girls among classmates? (about zero if random)"
 10.     reg share_girls_cls girl i.age_grp c.n_class if s_cls & wave == `w', vce(cluster classid)
 11. 
.     * Simulation: keep every class the same size but shuffle students' sex at random
.     * (within age group) 500 times. Compare how much classes differ in their share of girls
.     * in the real data with the same spread in the shuffled data.
.     preserve
 12.         quietly {
 13.             keep if wave == `w' & n_class >= 5 & !missing(girl, age_grp)
 14.             keep classid age_grp girl
 15.             save `base', replace
 16.             collapse (mean) cs = girl, by(classid)
 17.             summ cs
 18.             local real_sd = r(sd)
 19.             use `base', clear
 20.             sort age_grp classid
 21.             by age_grp: gen slot = _n
 22.             keep age_grp classid slot
 23.             save `pos', replace
 24.             use `base', clear
 25.             keep age_grp girl
 26.             save `gl', replace
 27.             tempname sim
 28.             postfile `sim' sd using "$out/sim_sd_`w'.dta", replace
 29.             forvalues r = 1/500 {
 30.                 use `gl', clear
 31.                 gen u = runiform()
 32.                 sort age_grp u
 33.                 by age_grp: gen slot = _n
 34.                 merge m:1 age_grp slot using `pos', nogen keep(match)
 35.                 collapse (mean) cs = girl, by(classid)
 36.                 summ cs
 37.                 post `sim' (r(sd))
 38.             }
 39.             postclose `sim'
 40.             use "$out/sim_sd_`w'.dta", clear
 41.             summ sd
 42.             local random_sd = r(mean)
 43.             count if sd <= `real_sd'
 44.             local share_below = r(N)/500
 45.             count if sd >= `real_sd'
 46.             local share_above = r(N)/500
 47.         }
 48.         di "Wave `w': real spread of class share girls = " %5.3f `real_sd' ", random-allocation spread = " %5.3f `random_s
> d' ///
>            ". Shuffled runs with a smaller spread: " %4.2f `share_below' "; with a larger spread: " %4.2f `share_above' "."
 49.         hist sd, xline(`real_sd') xscale(range(0.08 0.28)) xlabel(0.08(0.04)0.28) xtitle("Spread (SD) of class share girls
> ") ///
>             title("`w': shuffled classes (bars) vs real classes (line)")
 50.         graph export "$out/figures/Fig1_class_balance_`w'.png", replace width(1200)
 51.     restore
 52. }

