. ** A5. Do effects differ by own sex? **
. * The main coefficient is the effect for boys; the "girl#" line is how much the effect for
. * girls differs. "lincom" prints the total effect for girls.
. eststo clear

. foreach w in 2014 2018 2022 {
  2.     di _n "######## EFFECTS BY OWN SEX, `w' ########"
  3.     foreach y in complaints3 lifesat_z {
  4.         if `w' != 2018 {
  5.             eststo HS`w'_`y': quietly reg `y' c.share_bro##i.girl i.age_grp i.nsib fas_z $EMP ///
>                 if s_sib & wave == `w', vce(cluster classid)
  6.             di "Sibling gender, `y': effect for girls"
  7.             lincom share_bro + 1.girl#c.share_bro
  8.         }
  9.         eststo HC`w'_`y': quietly reg `y' c.share_girls_cls##i.girl i.age_grp c.n_class fas_z $EMP ///
>             if s_cls & wave == `w', vce(cluster classid)
 10.         di "Class composition, `y': effect for girls"
 11.         lincom share_girls_cls + 1.girl#c.share_girls_cls
 12.     }
 13. }

